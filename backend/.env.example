# ==============================================================
# つながるくまもと（Tsunagaru Kumamoto）バックエンド環境変数
# ローカル開発では .env にコピーして値を設定（.env は git 管理外にすること）
# 本番（Vercel）では Vercel の Environment Variables に同じキーを設定する
# ==============================================================

# ---- データベース（Supabase Postgres） ----
# 未設定の場合はローカルの SQLite（backend/data/tsunagaru.db）にフォールバックする。
# Supabase ダッシュボード > Project Settings > Database > Connection string (URI) から取得。
# サーバーレス環境からの接続には Transaction pooler（ポート6543・pgbouncer）を推奨。
DATABASE_URL=

# Supabase が自己署名/未検証証明書を使う環境で接続エラーになる場合のみ 0 にする（通常は不要）
# PGSSL_REJECT_UNAUTHORIZED=1

# ---- 画像アップロード（Supabase Storage） ----
# 両方未設定の場合はローカルの backend/uploads/ に保存する（Vercel等では永続化されないため本番では必須）。
# Supabase ダッシュボード > Project Settings > API から取得。
SUPABASE_URL=
# service_role キー（秘匿情報。anon keyではなくservice_role keyを使うこと）
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Storage 側に事前に作成しておく公開バケット名（未設定時は 'uploads'）
SUPABASE_STORAGE_BUCKET=uploads

# ---- メール送信（Resend） ----
# 未設定の場合は実送信せず、コンソールログに出力するだけの「送信シミュレーション」になる。
# https://resend.com でアカウント作成しAPIキーを発行。
RESEND_API_KEY=
# Resendで送信元として認証済みのドメイン/アドレス（例: notifications@yourdomain.jp）
EMAIL_FROM=notifications@example.com

# ---- SMS送信（Twilio優先 / Textbeltにフォールバック） ----
# 3つとも設定されていればTwilioを使用（有料・従量課金、日本向け送信実績あり）。
# https://www.twilio.com でアカウント作成 → Console DashboardでAccount SID/Auth Tokenを取得、
# 電話番号を1つ購入（SMS送信可能な番号）してTWILIO_FROM_NUMBERに設定（例: +12025551234）。
# 新規登録時は無料トライアルクレジットが付与されるため、まずは無料で実機テスト可能。
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Twilio未設定の場合のフォールバック: Textbelt（無料共有クォータキー 'textbelt'）を使用。
# ただし「サーバーのIPアドレスごとに1日1通」という非常に厳しい制限があり、
# 複数ユーザーが同時に登録するような本番運用には全く足りない。デモ・検証用途のみ。
# TEXTBELT_API_KEY=
# 開発時にSMSクォータを消費したくない場合は 1 を設定するとシミュレーションにフォールバックする
# TEXTBELT_DISABLED=1

# ---- 管理者パスワード（/admin 画面・行政お知らせ承認用） ----
ADMIN_PASSWORD=kumamoto-admin-2026

# ---- 画像アップロードの最大サイズ（バイト） ----
# Vercel serverless functions のリクエストボディ上限（既定4.5MB）を超えないよう、
# base64化による約33%の膨張を見込んだデフォルト値（3MB）を設定済み。変更は非推奨。
# MAX_IMAGE_BYTES=3145728

# ---- ローカル起動ポート ----
# PORT=8787
